# Sanity - Frontend (read-only, safe to expose)
VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production

# Sanity - Backend / Vercel (keep secret! never commit .env)
SANITY_API_PROJECT_ID=your_project_id
SANITY_API_DATASET=production
SANITY_API_WRITE_TOKEN=your_editor_token_here

# Optional: server port for local dev (default 3001)
# PORT=3001
